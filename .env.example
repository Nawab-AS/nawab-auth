# Supabase
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=sb_anon_xxx

# OIDC issuer and LibreChat client config
ISSUER_URL=http://127.0.0.1:5173
LIBRECHAT_CLIENT_ID=librechat
# Comma-separated allowlist
LIBRECHAT_REDIRECT_URIS=http://localhost:3080/api/auth/callback/oidc

# Optional but recommended: stable RSA private JWK for signing tokens.
# If omitted, the app generates an ephemeral key each boot.
# Keep as single-line JSON string.
# Example:
# OIDC_PRIVATE_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"...","kid":"nawab-auth-k1"}
OIDC_PRIVATE_JWK=


# human readable identifier
CLIENT_ID=my-localhost-app
# random string, keep secret. use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CLIENT_SECRET=some-random-string

# Support contact shown during onboarding for preferred name updates
SUPPORT_EMAIL=support@example.com