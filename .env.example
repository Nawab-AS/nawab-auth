# Supabase
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=sb_anon_xxx

# OIDC issuer and client config
OIDC_ISSUER_URL=http://localhost:5173
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# Comma-separated allowlist
OIDC_REDIRECT_URIS=https://demo.c2id.com/oidc-client/cb

# Optional but recommended: stable RSA private JWK for signing tokens.
# If omitted, the app generates an ephemeral key each boot.
# Keep as single-line JSON string.
# Example:
# OIDC_PRIVATE_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"...","kid":"nawab-auth-k1"}
OIDC_PRIVATE_JWK=

# Support contact shown during onboarding and account messaging
SUPPORT_EMAIL=support@example.com

# Optional verification email delivery (edge-safe HTTP provider)
RESEND_API_KEY=
RESEND_FROM_EMAIL=